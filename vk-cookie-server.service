[Unit]
Description=VK cookie receiver for Raisa (127.0.0.1:8002)
After=network.target

[Service]
Type=simple
User=iplly
ExecStart=/usr/bin/python3 /home/iplly/Programming/cpp/vk-ext/vk_cookie_server.py --config /home/iplly/Programming/cpp/RaisaAI/vk.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target